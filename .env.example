# Copy to .env and fill in. Never commit .env.

# Development: local SQLite file.
DATABASE_URL="file:./dev.db"

# Production (EU hosting, e.g. a Postgres instance in Frankfurt):
# set provider = "postgresql" in prisma/schema.prisma and use for example
# DATABASE_URL="postgresql://user:password@host:5432/arbeitsschutz?schema=public&sslmode=require"

# Secret used to sign the admin session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="bitte-ersetzen-durch-langen-zufallswert-mindestens-32-zeichen"
